{
  "name": "@avi2dg/subquo",
  "version": "0.1.0",
  "description": "Subscription quota reader for paid AI coding accounts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/subquo.git"
  },
  "author": {
    "name": "avi2d",
    "email": "avi2dg@gmail.com"
  },
  "type": "module",
  "bin": {
    "subquo": "src/launch.ts"
  },
  "scripts": {
    "subquo": "bun --no-env-file src/cli.ts",
    "build": "checks-effect-scope && checks-changelog",
    "release:assets": "bun --no-env-file scripts/release-assets.ts",
    "lint": "oxlint && checks-lint",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "checks-test",
    "test:e2e": "checks-test --tier=e2e",
    "test:fast": "checks-test --changed",
    "test:unit": "checks-test --tier=unit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@avi2dg/checks": "0.118.0",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.5"
  },
  "trustedDependencies": [
    "@swc/core"
  ],
  "publishConfig": {
    "access": "public"
  }
}
